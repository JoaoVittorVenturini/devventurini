# Caddy — alternativa ao Nginx. Faz o HTTPS sozinho, sem certbot.
# Copie para /etc/caddy/Caddyfile e rode: sudo systemctl reload caddy

devventurini.com {
    redir https://www.devventurini.com{uri} permanent
}

www.devventurini.com {
    root * /var/www/devventurini
    encode gzip

    @privado path /deploy/* /LEIA-ME.md
    respond @privado 404

    handle_errors {
        @404 expression {err.status_code} == 404
        rewrite @404 /404.html
        file_server
    }

    header /assets/* Cache-Control "public, max-age=604800"
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
    }

    file_server
}
